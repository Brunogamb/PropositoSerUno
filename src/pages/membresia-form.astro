---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MembershipForm from '../components/MembershipForm.astro';
---

<Layout 
    title="Formulario de Membresía | Propósito Ser Uno"
    description="Completa tu solicitud de membresía en Propósito Ser Uno. Únete a nuestra comunidad de salud y bienestar."
>
    <Header />
    <main>
        <section class="membership-section">
            <div class="container">
                <div class="form-container">
                    <MembershipForm />
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .membership-section {
        padding: 3rem 1.5rem;
        background: var(--bg-section);
        min-height: calc(100vh - 200px);
    }

    .container {
        max-width: 900px;
        margin: 0 auto;
    }

    .form-container {
        background: var(--white);
        border-radius: 20px 20px 12px 12px;
        overflow: hidden;
    }

    @media (max-width: 768px) {
        .membership-section {
            padding: 2rem 1rem;
        }

        .form-container {
            padding: 0;
        }
    }
</style>
