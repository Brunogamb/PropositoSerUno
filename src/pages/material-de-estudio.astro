---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/sections/page7/Hero.astro'
import IntroLogo from '../components/sections/page7/IntroLogo.astro';
import ProgramMaterial from '../components/sections/page7/ProgramMaterial.astro';
import TheChallenge from '../components/sections/page7/TheChallenge.astro';
import PreFooter from '../components/sections/PreFooter.astro';
---

<Layout
	title="Propósito Ser Uno | Conquistando salud y bienestar cada día"
	description="Un espacio pensado para acompañarte en tu proceso de salud. Tu salud y bienestar pueden mejorar cuando comenzás a participar activamente en ellos."
	image="/favicon.png"
	imageAlt="Propósito Ser Uno - Conquistando salud y bienestar cada día"
>
	<Header />
	<Hero />
	<IntroLogo />
	<ProgramMaterial />
	<TheChallenge />
	<PreFooter bgColor="var(--brand-orange-light)" title="Comunidad en formación, hacia una organización civil sin fines de lucro." />
</Layout>
