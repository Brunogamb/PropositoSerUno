<style>
footer {
    background: var(--brand-900);
    box-shadow: var(--shadow-top);
    display: flex;
    flex-direction: column; 
    align-items: center;
    justify-content: center;
    color: var(--white);
    text-wrap: balance;
    border-bottom: 13px solid var(--brand-orange-dark);
    padding: 0 20px 10px;
}

.footer-content {
    display: flex;
    gap: 150px;
    max-width: 1140px;
    width: 100%;
    padding: 46px 0 90px;
    font-weight: 500;
    font-family: var(--open-sans-font);
}

.column {
    display: flex;
    flex-direction: column;
}

h2 {
    font-size: 24px;
    font-family: var(--open-sans-font);
    font-weight: 600;
}

h3 {
    font-size: 17px;
    margin-top: 8px;
    font-family: var(--open-sans-font);
    font-weight: 400;
}

a {
    width: fit-content;
    transition: all 0.2s ease;
}

.footer-bottom {
    display: flex;
    justify-content: space-between; 
    width: 100%;
    max-width: 1140px;
    font-size: 14px;
    font-family: var(--open-sans-font);
    color: rgba(var(--white-rgb), 0.6);
}

.dev a {
    font-weight: 600;
    font-size: 15px;
    border-bottom: 1px solid rgba(var(--white-rgb), 0.6);
}

@media (hover: hover) {
    footer a:hover {
        color: var(--brand-orange);
        border-bottom-color: var(--brand-orange);
        text-decoration: underline 2px var(--brand-orange);
        text-underline-offset: 4px;
    }

    .dev a:hover {
        border-bottom-width: 2px;
    }
}

@media (max-width: 1024px) {
    .footer-content {
        flex-direction: column;
        gap: 40px;
        text-align: center;
        padding: 40px 20px;
    }

    .footer-bottom {
        flex-direction: column;
        text-align: center;
        gap: 10px;
    }

    .column {
        align-items: center;
    }
}
</style>