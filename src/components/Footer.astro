<footer>
    <div class="footer-content">
        <div class="column">
            <h2>Redes Sociales</h2>
            <h3>Próximamente</h3>
        </div>
        <div class="column">
            <a href="/aviso-legal">
                <h2>Aviso Legal</h2>
                <h3>Términos y Condiciones</h3>
                <h3>Política de Privacidad</h3>
            </a>
        </div>
        <div class="column">
            <h2>Contacto</h2>
            <h3>administracion@propositoseruno.com</h3>
            <h3>+54 9 3512 89-1029</h3>
        </div>
    </div>

    <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} Propósito Ser Uno.</p>
