        justify-content: center;
    }

    .container {
        max-width: 800px;
        width: 100%;
    }

    .eyebrow {
        display: block;
        font-family: var(--open-sans-font);
        color: var(--brand-700);
        font-weight: 600;
        font-size: 18px;
        letter-spacing: 1px;
        margin-bottom: 12px;
        text-transform: uppercase;
    }

    .last-eyebrow {
        margin-bottom: 2px;
    }

    .content {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 34px;
    }

    .content p, li {
        font-family: var(--open-sans-font);
        font-size: 21px;
        line-height: 1.6;
        font-weight: 400;
        color: var(--text);
        text-indent: 20px; 
        text-align: left;
        list-style: none;
    }

    ul {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .program-material-list {
        margin-bottom: 20px;
    }

    h3 {
        font-family: var(--open-sans-font);
        font-size: 22px;
        line-height: 1.6;
        font-weight: 600;
        color: var(--text);
    }

    .content strong {
        font-weight: 600;
        color: var(--text);
    }

    .content .intro-italic {
        font-style: italic;
        font-family: var(--lora-font);
        font-size: 20px;
        margin-bottom: 10px;
        text-indent: 0;
    }

    .content .last-paragraph {
        font-style: italic;
        margin: 20px 0 40px;
        text-indent: 0;
    }

    .about {
        margin-bottom: 40px;
    }

    .faq-inline {
        margin-bottom: 46px;
    }

    .faq-item {
        border-bottom: 1px solid var(--muted);
        cursor: pointer;
        width: 100%;
    }

    .faq-item summary {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 15px;
        font-family: var(--open-sans-font);
        font-size: 21px;
        font-weight: 400;
        color: var(--text);
        padding: 10px 0;
    }

    .faq-item summary::-webkit-details-marker {
        display: none;
    }

    .icon {
        font-size: 34px;
        font-weight: 300;
        transition: transform 0.3s ease;
        display: inline-block;
        color: var(--brand-700);
    }

    .faq-item[open] .icon {
        transform: rotate(45deg);
        color: var(--brand-orange-dark);
    }

    .question-text {
        flex: 1;
    }

    .answer {
        padding: 10px 0 10px 40px;
        overflow: hidden;
        display: none;
        font-family: var(--open-sans-font);
        font-size: 18px;
        line-height: 1.6;
        font-weight: 300;
        color: var(--text);
    }

    .faq-item[open] .answer {
        display: block;
        animation: slideDown 0.3s ease forwards;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    .answer ul.meditations li::marker {
        color: var(--brand-700);
    }

    .program-material-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
        list-style: none;
        padding-left: 0;
        margin: 0;
    }

    .program-material-list > li {
        position: relative;
        padding-left: 22px;
    }

    .program-material-list > li::before {
        content: "–";
        position: absolute;
        left: 0;
        color: var(--brand-700);
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .program-material { 
            padding: 40px 16px; 
        }

        .content p, li, .content .intro-italic, .content .last-paragraph { 
