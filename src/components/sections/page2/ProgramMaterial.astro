            line-height: 1.6;
        }

        .eyebrow {
            margin-bottom: 12px;
        }

        .last-eyebrow {
            margin-bottom: 2px;
        }

        .content {
            margin-bottom: 0px;
        }

        h3 {
            font-size: 21px;
        }

        .faq-item summary {
            font-size: 18px;
        }

        .answer {
            padding-left: 30px;
            font-size: 18px;
            line-height: 1.6;
        }

        .faq { 
            padding: 40px 16px; 
        }

        h2 {
            font-size: 21px;
        }
    }
</style>