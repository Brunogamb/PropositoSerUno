---
import { Image } from 'astro:assets';

import LogoPSU from '../../../assets/Logo_PSU.webp';
---

<section>
    <div class="container">
        <Image src={LogoPSU} alt="Logo de Propósito Ser Uno" loading="lazy" class="logo"/>
        <h2>Conquistando Salud y Bienestar</h2>
    </div>
</section>

<style>
    section {
        color: var(--text);
        background: var(--white);
        padding: 40px 20px 0px;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
    }

    .intro-proposal {
        background-color: var(--white);
        display: flex;
        justify-content: center;
    }

    .logo {
        width: 200px;
        height: auto;
        display: block;
        margin: 20px auto 20px;
    }

    h2 {
        font-family: var(--lora-font);
        font-size: 36px;
        font-weight: 400;
        line-height: 1.6;
        text-align: center;
        margin: 16px 0 20px 0;
        text-wrap: balance;
        color: var(--brand-800);
    }

    @media (max-width: 768px) {
        section {
            padding: 40px 16px; 
        }

        .container {
            padding-top: 20px;
        }

        h2 {
            font-size: 28px;
            margin-bottom: 30px;
        }

        .logo {
            width: 150px;
        }
    }
</style>