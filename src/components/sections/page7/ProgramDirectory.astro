---
    const modules = [
    {
        id: 1,
        title: "Módulo 1: Introducción y Fundamentos",
        files: [
        { name: "Guía de Inicio (PDF)", type: "pdf", url: "/" },
        { name: "Audio Introductorio (MP3)", type: "audio", url: "/" }
        ]
    },
    {
        id: 2,
        title: "Módulo 2: Desarrollo de Habilidades",
        files: [
        { name: "Guía de Inicio (PDF)", type: "pdf", url: "/" },
        { name: "Audio Introductorio (MP3)", type: "audio", url: "/" }
        ]
    },
    {
        id: 3,
        title: "Módulo 3: Aplicación Práctica",
        files: [
        { name: "Guía de Inicio (PDF)", type: "pdf", url: "/" },
        { name: "Audio Introductorio (MP3)", type: "audio", url: "/" }
        ]
    },
    ];
---

<div class="directory-accordion">
    {modules.map((mod) => (
        <details class="module-card">
        <summary class="module-header">
            <svg class="folder-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h5l2 2h8A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z" />
                <path d="M3 9h18" />
            </svg>
            <strong>{mod.title}</strong>
        </summary>
        <div class="module-files">
            <ul>
            {mod.files.map((file) => (
                <li class="file-item">
                <span class="file-name">{file.name}</span>
                {file.type === 'pdf' && (
                    <a href={file.url} target="_blank" rel="noopener noreferrer" class="btn-view">Ver PDF</a>
                )}
                {file.type === 'audio' && (
                    <audio controls src={file.url} class="audio-player"></audio>
                )}
                </li>
            ))}
            </ul>
        </div>
        </details>
    ))}
</div>

<style>
    .directory-accordion {
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 100%;
    }

    .module-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 12px 16px;
        transition: all 0.2s ease;
    }

    .module-card[open] {
        border-color: var(--brand-700, #4f46e5);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .module-header {
        cursor: pointer;
        font-size: 18px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        user-select: none;
        text-indent: 0 !important;
    }

    .folder-icon {
        width: 20px;
        height: 20px;
        flex: 0 0 20px;
        color: var(--brand-700, #4f46e5);
    }

    .module-files {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #f1f5f9;
    }

    .file-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 0;
        font-size: 16px !important;
        text-indent: 0 !important;
    }

    .btn-view {
        padding: 4px 12px;
        background-color: var(--brand-700, #4f46e5);
        color: #ffffff;
        border-radius: 4px;
        text-decoration: none;
        font-size: 14px;
    }

    .audio-player {
        height: 36px;
    }
</style>