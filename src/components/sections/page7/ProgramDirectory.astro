---
import { getFolderTree, type DriveItem } from '../../../lib/googleDrive';
import DriveNode from './DriveNode.astro';

let modules: DriveItem[] = [];
let errorMsg = '';

try {
    modules = await getFolderTree();
} catch (err) {
    console.error('Error cargando carpetas de Google Drive:', err);
    errorMsg = 'No se pudo cargar el material en este momento.';
}

function countFiles(item: DriveItem): number {
    if (!item.isFolder) return 1;
    if (!item.children) return 0;
    return item.children.reduce((acc, child) => acc + countFiles(child), 0);
}
---

<div class="portal-workspace">
    {errorMsg && <p class="error-banner">{errorMsg}</p>}

    {!errorMsg && modules.length > 0 && (
        <div class="portal-toolbar">
            <div class="search-box">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input
                    type="search"
                    id="psu-material-search"
                    placeholder="Buscar archivo, audio o video..."
                    autocomplete="off"
                />
            </div>

            <div class="module-select-wrap">
                <select id="psu-module-select" aria-label="Filtrar por módulo">
                    <option value="all">Todos los módulos ({modules.length})</option>
                    {modules.map((mod, idx) => (
                        <option value={`mod-${idx}`}>{mod.name} ({countFiles(mod)})</option>
                    ))}
                </select>
            </div>
        </div>
    )}

    <div class="modules-content">
        <p id="psu-no-results" class="empty-search-msg" hidden>
            No se encontraron materiales que coincidan con tu búsqueda.
        </p>

        {modules.map((mod, idx) => (
            <section class="module-panel" id={`mod-${idx}`}>
                <header class="panel-header">
                    <h3 class="panel-title">{mod.name}</h3>
                    <span class="panel-count">{countFiles(mod)} {countFiles(mod) === 1 ? 'archivo' : 'archivos'}</span>
                </header>

                <div class="panel-body">
                    {mod.children && mod.children.length > 0 ? (
                        <ul class="files-list">
                            {mod.children.map((child) => (
                                <DriveNode item={child} />
                            ))}
                        </ul>
                    ) : (
                        <p class="empty-msg">Sin archivos disponibles.</p>
                    )}
                </div>
            </section>
        ))}
    </div>
</div>

<!-- Modal Visor Integrado -->
<div id="psu-viewer-modal" class="viewer-modal" hidden>
    <div class="viewer-backdrop" id="psu-viewer-backdrop"></div>
    <div class="viewer-box">
        <div class="viewer-top">
            <h3 id="psu-viewer-title">Cargando...</h3>
            <button type="button" id="psu-viewer-close" class="viewer-close" aria-label="Cerrar">✕</button>
        </div>
        <div id="psu-viewer-content" class="viewer-content">
            <p class="loading-text">Cargando archivo...</p>
        </div>
    </div>
</div>

<style is:global>
    .portal-workspace {
        width: 100%;
        max-width: 920px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 16px;
        box-sizing: border-box;
    }

    .portal-workspace *,
    .viewer-modal * {
        box-sizing: border-box;
    }

    .portal-toolbar {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 12px;
        background: #ffffff;
        padding: 12px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

    .search-box {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        width: 18px;
        height: 18px;
        color: #64748b;
        pointer-events: none;
    }

    #psu-material-search {
        width: 100%;
        padding: 10px 12px 10px 38px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 16px;
        color: var(--brand-900, #1e293b);
        background: #f8fafc;
        transition: border-color 0.15s ease, background 0.15s ease;
    }

    #psu-material-search:focus {
        outline: none;
        border-color: var(--brand-orange, #ea580c);
        background: #ffffff;
    }

    .module-select-wrap {
        display: flex;
    }

    #psu-module-select {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        color: var(--brand-900, #1e293b);
        background: #ffffff;
        cursor: pointer;
    }

    #psu-module-select:focus {
        outline: none;
        border-color: var(--brand-orange, #ea580c);
    }

    .modules-content {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .module-panel {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 14px 18px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .panel-title {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: var(--brand-900, #1e293b);
        line-height: 1.3;
    }

    .panel-count {
        flex-shrink: 0;
        font-size: 13px;
        font-weight: 600;
        color: #64748b;
    }

    .panel-body {
        padding: 4px 16px 10px;
    }

    .files-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .files-list.nested {
        padding-left: 14px;
        margin-top: 2px;
        border-left: 2px solid #e2e8f0;
    }

    .folder-group {
        padding: 4px 0;
    }

    .folder-summary {
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 9px 6px;
        font-weight: 700;
        font-size: 15px;
        color: var(--brand-900, #1e293b);
        list-style: none;
        user-select: none;
    }

    .folder-summary::-webkit-details-marker {
        display: none;
    }

    .folder-label {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sub-icon {
        width: 17px;
        height: 17px;
        color: var(--brand-orange-dark, #c2410c);
        flex-shrink: 0;
    }

    .folder-details[open] .folder-arrow {
        transform: rotate(180deg);
    }

    .file-row {
        border-bottom: 1px solid #f1f5f9;
    }

    .file-row:last-child {
        border-bottom: none;
    }

    .file-row-btn {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 8px;
        background: transparent;
        border: none;
        text-align: left;
        cursor: pointer;
        border-radius: 8px;
        transition: background 0.15s ease;
    }

    @media (hover: hover) {
        .file-row-btn:hover {
            background: #f8fafc;
        }
        .file-row-btn:hover .file-action {
            background: var(--brand-orange-dark, #c2410c);
            color: #ffffff;
        }
    }

    .file-badge {
        flex-shrink: 0;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 7px;
        border-radius: 5px;
        text-transform: uppercase;
    }

    .badge-pdf { background: #fee2e2; color: #b91c1c; }
    .badge-audio { background: #e0e7ff; color: #3730a3; }
    .badge-video { background: #ffedd5; color: #c2410c; }
    .badge-other { background: #f1f5f9; color: #475569; }

    .file-title {
        flex: 1 1 auto;
        font-size: 15px;
        font-weight: 500;
        color: #1e293b;
        word-break: break-word;
        line-height: 1.35;
    }

    .file-action {
        flex-shrink: 0;
        font-size: 13px;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 6px;
        background: #f1f5f9;
        color: var(--brand-900, #1e293b);
        transition: background 0.15s ease, color 0.15s ease;
    }

    .empty-msg,
    .empty-search-msg {
        font-size: 14px;
        color: #64748b;
        margin: 14px 0;
        text-align: center;
    }

    .error-banner {
        padding: 14px 16px;
        background: #fee2e2;
        color: #991b1b;
        border-radius: 8px;
        font-size: 15px;
    }

    .viewer-modal {
        position: fixed;
        inset: 0;
        z-index: 20000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .viewer-modal[hidden] {
        display: none;
    }

    .viewer-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.85);
    }

    .viewer-box {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1120px;
        height: 92dvh;
        max-height: 92dvh;
        background: #f1f5f9;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .viewer-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 16px;
        background: var(--brand-900, #1e293b);
        color: #ffffff;
        flex-shrink: 0;
    }

    .viewer-top h3 {
        margin: 0;
        font-size: 15px;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .viewer-close {
        background: rgba(255, 255, 255, 0.15);
        border: none;
        color: #ffffff;
        width: 34px;
        height: 34px;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        flex-shrink: 0;
    }

    .viewer-content {
        padding: 14px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        min-height: 260px;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        flex: 1 1 auto;
    }

    .viewer-content.is-centered {
        justify-content: center;
    }

    .viewer-content.is-pdf-desktop {
        padding: 0;
        overflow: hidden;
    }

    .btn-action-modal {
        display: inline-block;
        padding: 10px 18px;
        background: var(--brand-orange-dark, #c2410c);
        color: #ffffff;
        text-decoration: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .portal-toolbar {
            grid-template-columns: 1fr;
        }

        .panel-header {
            padding: 12px 14px;
        }

        .panel-title {
            font-size: 16px;
        }

        .panel-body {
            padding: 4px 10px 10px;
        }

        .files-list.nested {
            padding-left: 8px;
        }

        .viewer-modal {
            padding: 0;
        }

        .viewer-box {
            max-width: 100%;
            height: 100dvh;
            max-height: 100dvh;
            border-radius: 0;
        }

        .viewer-content {
            padding: 10px;
        }
    }
</style>

<script is:inline>
    const modal = document.getElementById('psu-viewer-modal');
    const backdrop = document.getElementById('psu-viewer-backdrop');
    const closeBtn = document.getElementById('psu-viewer-close');
    const titleEl = document.getElementById('psu-viewer-title');
    const contentEl = document.getElementById('psu-viewer-content');

    const moduleSelect = document.getElementById('psu-module-select');
    const panels = document.querySelectorAll('.module-panel');
    const searchInput = document.getElementById('psu-material-search');
    const noResultsMsg = document.getElementById('psu-no-results');

    moduleSelect?.addEventListener('change', (e) => {
        const target = e.target.value;
        if (searchInput && searchInput.value) {
            searchInput.value = '';
            filterMaterials('');
        }
        panels.forEach((panel) => {
            panel.hidden = target !== 'all' && panel.id !== target;
        });
    });

    function filterMaterials(query) {
        const q = query.trim().toLowerCase();
        let anyVisible = false;

        if (!q) {
            noResultsMsg.hidden = true;
            document.querySelectorAll('.js-searchable-item, .js-searchable-folder').forEach((el) => {
                el.hidden = false;
            });
            const target = moduleSelect ? moduleSelect.value : 'all';
            panels.forEach((p) => {
                p.hidden = target !== 'all' && p.id !== target;
            });
            return;
        }

        panels.forEach((panel) => {
            const items = panel.querySelectorAll('.js-searchable-item');
            let panelHasMatch = false;

            items.forEach((item) => {
                const match = item.dataset.name.includes(q);
                item.hidden = !match;
                if (match) {
                    panelHasMatch = true;
                    anyVisible = true;
                }
            });

            panel.querySelectorAll('.js-searchable-folder').forEach((folder) => {
                const visibleChildren = folder.querySelectorAll('.js-searchable-item:not([hidden])');
                folder.hidden = visibleChildren.length === 0;
            });

            panel.hidden = !panelHasMatch;
        });

        noResultsMsg.hidden = anyVisible;
    }

    searchInput?.addEventListener('input', (e) => filterMaterials(e.target.value));

    let cachedDriveToken = null;
    let tokenExpiresAt = 0;
    let inFlightTokenPromise = null;
    const fileUrlCache = new Map();
    let pdfjsPromise = null;

    function getPdfJs() {
        if (!pdfjsPromise) {
            pdfjsPromise = import('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.2.67/pdf.min.mjs').then((lib) => {
                lib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.2.67/pdf.worker.min.mjs';
                return lib;
            });
        }
        return pdfjsPromise;
    }

    async function getValidDriveToken() {
        const now = Date.now();
        if (cachedDriveToken && now < tokenExpiresAt) return cachedDriveToken;
        if (inFlightTokenPromise) return inFlightTokenPromise;

        inFlightTokenPromise = (async () => {
            try {
                const tokenRes = await fetch('/api/drive-token', { credentials: 'same-origin' });
                if (tokenRes.status === 401) {
                    window.location.href = '/login';
                    throw new Error('Sesión expirada');
                }
                if (!tokenRes.ok) throw new Error('Error al autorizar acceso');

                const { token } = await tokenRes.json();
                cachedDriveToken = token;
                tokenExpiresAt = Date.now() + 45 * 60 * 1000;
                return token;
            } finally {
                inFlightTokenPromise = null;
            }
        })();

        return inFlightTokenPromise;
    }

    getValidDriveToken().catch(() => {});

    function closeModal() {
        const media = contentEl.querySelector('video, audio');
        if (media) {
            media.pause();
            media.removeAttribute('src');
            media.load();
        }
        modal.hidden = true;
        contentEl.classList.remove('is-centered', 'is-pdf-desktop');
        contentEl.innerHTML = '';
        document.body.style.overflow = '';
    }

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    function isMobileOrTablet() {
        return window.innerWidth <= 768 ||
               /iPad|iPhone|iPod|Android/.test(navigator.userAgent) ||
               (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    }

    async function renderPdfPagesMobile(objectUrl) {
        contentEl.classList.remove('is-centered', 'is-pdf-desktop');
        contentEl.innerHTML = '<p class="loading-text" style="margin: 24px 0;">Cargando páginas del PDF...</p>';

        const pdfjsLib = await getPdfJs();
        const pdf = await pdfjsLib.getDocument(objectUrl).promise;

        const pagesWrapper = document.createElement('div');
        pagesWrapper.style.cssText = 'width: 100%; display: flex; flex-direction: column; align-items: center; gap: 12px;';
        contentEl.innerHTML = '';
        contentEl.appendChild(pagesWrapper);

        const availableWidth = Math.min(pagesWrapper.clientWidth || window.innerWidth - 20, 920);
        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
            if (modal.hidden) break;
            const page = await pdf.getPage(pageNum);
            const baseViewport = page.getViewport({ scale: 1 });
            const cssScale = availableWidth / baseViewport.width;
            const viewport = page.getViewport({ scale: cssScale * dpr });

            const canvas = document.createElement('canvas');
            canvas.width = Math.floor(viewport.width);
            canvas.height = Math.floor(viewport.height);
            canvas.style.width = `${Math.floor(baseViewport.width * cssScale)}px`;
            canvas.style.height = 'auto';
            canvas.style.background = '#ffffff';
            canvas.style.borderRadius = '6px';
            canvas.style.boxShadow = '0 2px 8px rgba(15, 23, 42, 0.12)';

            pagesWrapper.appendChild(canvas);
            const ctx = canvas.getContext('2d');
            if (ctx) {
                await page.render({ canvasContext: ctx, viewport }).promise;
            }
        }
    }

    async function renderFileInModal(objectUrl, fileName, mimeType) {
        contentEl.classList.remove('is-centered', 'is-pdf-desktop');

        if (mimeType.includes('pdf')) {
            if (isMobileOrTablet()) {
                await renderPdfPagesMobile(objectUrl);
            } else {
                // En PC usa el visor nativo con toda la barra de herramientas (zoom, páginas, rotación, búsqueda, descarga)
                contentEl.classList.add('is-pdf-desktop');
                contentEl.innerHTML = `
                    <iframe
                        src="${objectUrl}#toolbar=1&navpanes=0&view=FitH"
                        style="width: 100%; height: 100%; border: none;"
                        title="${fileName}"
                    ></iframe>
                `;
            }
        } else if (mimeType.startsWith('audio/')) {
            contentEl.classList.add('is-centered');
            contentEl.innerHTML = `
                <div style="width: 100%; max-width: 520px; text-align: center; padding: 24px 12px; background: #fff; border-radius: 12px;">
                    <p style="margin-bottom: 16px; font-weight: 600; color: #1e293b;">${fileName}</p>
                    <audio controls autoplay playsinline src="${objectUrl}" style="width: 100%;"></audio>
                </div>
            `;
        } else {
            contentEl.classList.add('is-centered');
            contentEl.innerHTML = `
                <div style="text-align: center; padding: 24px; background: #fff; border-radius: 12px;">
                    <p style="margin-bottom: 14px;">Este formato no se puede previsualizar directamente.</p>
                    <a href="${objectUrl}" download="${fileName}" class="btn-action-modal">Descargar archivo</a>
                </div>
            `;
        }
    }

    document.querySelectorAll('.js-open-file').forEach((btn) => {
        btn.addEventListener('click', async () => {
            const fileId = btn.dataset.fileId;
            const fileName = btn.dataset.fileName;
            const mimeType = btn.dataset.fileMime;

            titleEl.textContent = fileName;
            modal.hidden = false;
            document.body.style.overflow = 'hidden';

            const isVideo = mimeType.startsWith('video/') || fileName.toLowerCase().endsWith('.avi');

            if (isVideo) {
                contentEl.classList.remove('is-pdf-desktop');
                contentEl.classList.add('is-centered');
                const isAvi = mimeType.includes('avi') || fileName.toLowerCase().endsWith('.avi');

                if (isAvi) {
                    contentEl.innerHTML = `
                        <iframe
                            src="https://drive.google.com/file/d/${fileId}/preview"
                            style="width: 100%; height: 78dvh; border: none; border-radius: 6px; background: #000;"
                            allow="autoplay; fullscreen"
                            allowfullscreen
                            title="${fileName}"
                        ></iframe>
                    `;
                } else {
                    contentEl.innerHTML = `
                        <video
                            controls
                            autoplay
                            playsinline
                            preload="metadata"
                            src="/api/stream/${fileId}"
                            style="width: 100%; max-height: 80dvh; border-radius: 6px; background: #000;"
                        ></video>
                    `;
                }
                return;
            }

            if (fileUrlCache.has(fileId)) {
                await renderFileInModal(fileUrlCache.get(fileId), fileName, mimeType);
                return;
            }

            contentEl.classList.remove('is-pdf-desktop');
            contentEl.classList.add('is-centered');
            contentEl.innerHTML = '<p class="loading-text">Cargando material...</p>';

            try {
                const token = await getValidDriveToken();
                const fileRes = await fetch(`https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`, {
                    headers: { Authorization: `Bearer ${token}` }
                });

                if (!fileRes.ok) throw new Error('Error descargando archivo desde Drive');

                const blob = await fileRes.blob();
                const objectUrl = URL.createObjectURL(blob);
                fileUrlCache.set(fileId, objectUrl);

                await renderFileInModal(objectUrl, fileName, mimeType);
            } catch (error) {
                console.error(error);
                cachedDriveToken = null;
                tokenExpiresAt = 0;
                contentEl.classList.remove('is-pdf-desktop');
                contentEl.classList.add('is-centered');
                contentEl.innerHTML = '<p class="error-banner">No se pudo cargar el archivo. Intentá nuevamente.</p>';
            }
        });
    });
</script>