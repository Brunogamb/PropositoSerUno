---
import { Image } from 'astro:assets';
import Logo from '../../assets/Logo.webp';
import Button from '../ui/Button.astro';

interface Props {
    title?: string;
    bgColor?: string;
    showButtons?: boolean;
}

const {
    title = 'Un espacio con el potencial de mejorar tu salud y tu calidad de vida.',
    bgColor = 'var(--bg-section)',
    showButtons = false
} = Astro.props;
---

<section class="prefooter" style={{ backgroundColor: bgColor }}>
    <div class="container">
        <div class="content">
            <a href="/"><Image src={Logo} alt="Logo de Propósito Ser Uno" class="logo" loading="lazy"/></a>
            <h2>{title}</h2>
        </div>

        {showButtons && (
            <div class="actions">
                <Button variant="primary" text="Membresía" href="/membresia" className="small-btn" />
                <Button variant="outline" text="Explorar Programa" href="/programa" className="small-btn" />
                <Button variant="primary" text="Fundadores" href="/fundadores" className="small-btn" />
                <Button variant="secondary" text="Ver Comunidad" href="/comunidad" className="small-btn" />
            </div>
        )}
    </div>
</section>

<style>
    .prefooter {
        padding: 70px 20px 40px 20px;
        color: var(--text);
        display: flex;
        justify-content: center;
    }

    .container {
        max-width: 1140px;
        width: 100%;
    }

    .content {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 40px;
    }

    .content h2 {
        font-family: var(--open-sans-font);
        font-size: 28px;
        line-height: 1.6;
        font-weight: 400;
        color: var(--text-light);
        text-align: left;
    }

    .actions {
        display: flex;
        justify-content: space-between;
        width: 100%;
        flex-wrap: wrap;
        gap: 18px;
    }

    :global(.btn-base.small-btn) {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 10px;
        padding-bottom: 10px;
        font-size: 24px;
    }

    .logo {
        width: min(380px, 100%);
        height: auto;
        display: block;
    }

    a {
        width: fit-content;
    }

    @media (max-width: 1024px) {
        .prefooter {
            padding: 80px 20px 24px;
        }

        .content h2 {
            font-size: 26px;
            line-height: 1.55;
        }

        :global(.btn-base.small-btn) {
            font-size: 20px;
        }
    }

    @media (max-width: 768px) {
        .prefooter {
            padding: 40px 16px;
        }

        .content h2 {
            font-size: 21px;
            line-height: 1.6;
            text-align: center;
        }

        .actions {
            flex-direction: column;
            align-items: stretch;
            justify-content: center;
            gap: 14px;
        }

        :global(.btn-base.small-btn) {
            width: 100%;
            min-width: 0;
            padding: 12px 14px;
            font-size: 22px;
        }

        .content {
            margin-bottom: 30px;
        }

        a {
            display: flex;
            justify-content: center; 
            align-items: center;
        }
    }
</style>