        max-width: 800px;
        width: 100%;
        text-align: center;
    }

    .main-quote {
        font-family: var(--lora-font);
        font-size: 35px;
        line-height: 1.4;
        font-weight: 400;
        margin-bottom: 30px;
        color: var(--text);
    }

    .content {
        display: flex;
        flex-direction: column;
        gap: 25px;
        text-align: left;
    }

    .content p {
        font-family: var(--open-sans-font);
        font-size: 21px;
        line-height: 1.6;
        font-weight: 400;
        color: var(--text);
        text-indent: 20px; 
        text-align: left;
    }

    .content strong {
        font-weight: 700;
        color: var(--text);
    }

