---
import Button from '../../ui/Button.astro';
---

<section class="community-vision">
    <div class="container">
        <p class="title"><strong>Sumate a Propósito Ser Uno</strong>, una comunidad comprometida con impulsar la evolución mental y el desarrollo espiritual en el mundo.</p>
        <div class="actions">
            <Button variant="primary" text="Membresía" href="/membresia" className="big-btn"/>
        </div>
    </div>
</section>

<style>
    .community-vision {
        background-color: var(--white);
        padding: 60px 20px 30px 20px;
        color: var(--text);
        display: flex;
        justify-content: center;
    }

    .container {
        max-width: 800px;
        width: 100%;
    }

    .title {
        font-family: var(--lora-font);
        font-size: 24px;
        font-style: italic;
        font-weight: 400;
        color: var(--text);
        text-align: center;
        margin: auto auto 50px auto;
        max-width: 450px;
        text-wrap: balance;
        line-height: 1.5;
    }

    .actions {
        display: flex;
        justify-content: center;
        margin-bottom: 14px;
    }

    :global(.btn-base.big-btn) {
        padding-left: 50px;
        padding-right: 50px;
        padding-top: 10px;
        padding-bottom: 10px;
        font-size: 30px;
    }

    @media (max-width: 768px) {
        .title { 
            font-size: 20px; 
            margin-bottom: 40px;
        }

        :global(.btn-base.big-btn) {
            padding-left: 40px;
            padding-right: 40px;
            padding-top: 8px;
            padding-bottom: 8px;
            font-size: 25px;
        }

        .community-vision { 
            padding: 40px 16px; 
        }
    }
</style>