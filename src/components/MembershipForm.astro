---
export interface Props {
    className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`membership-form-wrapper ${className}`}>
    <form id="membership-form" class="membership-form">
        <div class="form-section">
        <h3 class="section-title">Datos personales</h3>
        <p class="section-description">Los campos marcados con (*) son obligatorios.</p>

        <div class="form-grid">
            <div class="form-group">
            <label for="apellido" class="form-label">Apellido/s <span class="required">*</span></label>
            <input
                type="text"
                id="apellido"
                name="apellido"
                class="form-input"
                required
            />
            </div>

            <div class="form-group">
            <label for="nombre" class="form-label">Nombre/s <span class="required">*</span></label>
            <input
                type="text"
                id="nombre"
                name="nombre"
                class="form-input"
                required
            />
            </div>

            <div class="form-group">
            <label for="fechaNacimiento" class="form-label">Fecha de nacimiento <span class="required">*</span></label>
            <input
                type="date"
                id="fechaNacimiento"
                name="fechaNacimiento"
                class="form-input"
                required
            />
            </div>

            <div class="form-group">
            <label for="numeroCelular" class="form-label">Número de celular <span class="required">*</span></label>
            <input
                type="tel"
                id="numeroCelular"
                name="numeroCelular"
                class="form-input"
                required
            />
            </div>

            <div class="form-group">
            <label for="correoElectronico" class="form-label">Correo electrónico <span class="required">*</span></label>
            <input
                type="email"
                id="correoElectronico"
                name="correoElectronico"
                class="form-input"
                required
            />
            </div>

            <div class="form-group">
            <label for="ciudad" class="form-label">Ciudad <span class="required">*</span></label>
            <input
                type="text"
                id="ciudad"
                name="ciudad"
                class="form-input"
                required
            />
            </div>

            <div class="form-group">
            <label for="provinciaEstado" class="form-label">Provincia / Estado <span class="required">*</span></label>
            <input
                type="text"
                id="provinciaEstado"
                name="provinciaEstado"
                class="form-input"
                required
            />
            </div>

            <div class="form-group">
            <label for="pais" class="form-label">País <span class="required">*</span></label>
            <input
                type="text"
                id="pais"
                name="pais"
                class="form-input"
                required
            />
            </div>
        </div>
        </div>

        <div class="form-section">
        <h3 class="section-title">Incorporación al grupo de WhatsApp</h3>
        <p class="section-description">La incorporación al grupo de WhatsApp es opcional y no condiciona la membresía en Propósito Ser Uno. Selecciona una de las siguientes opciones:</p>

        <div class="form-group radio-group">
            <div class="radio-item">
            <input
                type="radio"
                id="whatsapp-auto-si"
                name="whatsappAuto"
                value="true"
                class="form-radio"
            />
            <label for="whatsapp-auto-si" class="radio-label">
                Autorizo mi incorporación automática al grupo de WhatsApp de Propósito Ser Uno.
            </label>
            </div>

            <div class="radio-item">
            <input
                type="radio"
                id="whatsapp-auto-no"
                name="whatsappAuto"
                value="false"
                class="form-radio"
                checked
            />
            <label for="whatsapp-auto-no" class="radio-label">
                No autorizo mi incorporación automática al grupo de WhatsApp de Propósito Ser Uno.
            </label>
            </div>
        </div>

        <p class="whatsapp-note">
            Una vez confirmada mi membresía, un integrante del equipo administrativo de Propósito Ser Uno se pondrá en contacto contigo a la brevedad para brindarte la información y el material de orientación necesarios para facilitar tu comienzo en la comunidad.
        </p>
        </div>

        <div class="form-section">
            <h3 class="section-title stat-title">¿Cómo conociste Propósito Ser Uno?</h3>
            <p class="section-description stat-description">La siguiente pregunta es a modo estadístico y no es obligatoria.</p>

            <div class="form-group checkbox-group">
                <label class="checkbox-item checkbox-label">
                <input type="checkbox" name="comoConoce" value="Internet" class="form-checkbox stat-checkbox" />
                <span>Internet</span>
                </label>

                <label class="checkbox-item checkbox-label">
                <input type="checkbox" name="comoConoce" value="Redes sociales" class="form-checkbox stat-checkbox" />
                <span>Redes sociales</span>
                </label>

                <label class="checkbox-item checkbox-label">
                <input type="checkbox" name="comoConoce" value="Me lo recomendó un conocido" class="form-checkbox stat-checkbox" />
                <span>Me lo recomendó un conocido</span>
                </label>

                <label class="checkbox-item checkbox-label">
                <input type="checkbox" name="comoConoce" value="Otro" class="form-checkbox stat-checkbox" />
                <span>Otro</span>
                </label>
            </div>
        </div>

        <div class="form-section last-section">
            <h3 class="section-title">Aceptación</h3>
            <p class="section-description">Las siguientes declaraciones son obligatorias para completar la solicitud de membresía:</p>

            <div class="form-group checkbox-group">
                <label class="checkbox-item checkbox-label">
                <input
                    type="checkbox"
                    id="terminos"
                    name="aceptaTerminos"
                    class="form-checkbox"
                    required
                />
                <span>Declaro haber leído y acepto los Términos y Condiciones de Membresía y las Condiciones de Uso de Propósito Ser Uno.</span>
                </label>

                <label class="checkbox-item checkbox-label">
                <input
                    type="checkbox"
                    id="privacidad"
                    name="aceptaPrivacidad"
                    class="form-checkbox"
                    required
                />
                <span>Declaro haber leído la Política de Privacidad y acepto el tratamiento de mis datos personales de acuerdo con lo establecido en ella.</span>
                </label>
            </div>
        </div>

            <div class="form-actions">
            <button type="submit" class="btn-submit">Enviar Solicitud</button>
            </div>

        <div id="form-message" class="form-message"></div>
    </form>
</div>

<style>
    .membership-form-wrapper {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
    }

    .membership-form {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .form-section {
        display: flex;
        flex-direction: column;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--muted);
    }

    .last-section {
        border-bottom: none;
        padding-bottom: 0;
    }

    .section-title {
        font-size: 25px;
        font-weight: 600;
        color: var(--brand-900);
        font-family: var(--lora-font);
    }

    .section-description {
        font-size: 18px;
        color: var(--text-light);
        line-height: 1.5;
        font-style: italic;
        margin: 0.6rem 0 1.5rem;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.25rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-label {
        font-size: 16px;
        font-weight: 500;
        color: var(--text);
        font-family: var(--open-sans-font);
    }

    .required {
        color: var(--brand-orange-dark);
        font-weight: 600;
    }

    .form-input {
        padding: 0.75rem;
        border: 2px solid var(--muted);
        border-radius: 8px;
        font-family: var(--open-sans-font);
        font-size: 16px;
        color: var(--text);
        transition: border-color 0.3s ease;
    }

    .form-input:focus {
        outline: none;
        border-color: var(--brand-orange);
        box-shadow: 0 0 0 3px rgba(255, 152, 84, 0.1);
    }

    .radio-group {
        gap: 1rem;
    }

    .radio-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .form-radio {
        width: 16px;
        height: 16px;
        margin-top: 0.2rem;
        cursor: pointer;
        accent-color: var(--brand-orange);
        flex-shrink: 0;
    }

    .radio-label {
        font-size: 16px;
        color: var(--text);
        cursor: pointer;
        line-height: 1.4;
    }

    .whatsapp-note {
        font-size: 16px;
        color: var(--text-light);
        line-height: 1.5;
        padding: 1rem;
        background-color: var(--bg-section-orange);
        border-radius: 8px;
        margin-top: 1.5rem;
    }

    .checkbox-group {
        gap: 1rem;
    }

    .checkbox-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .form-checkbox {
        width: 18px;
        height: 18px;
        margin-top: 0.15rem;
        cursor: pointer;
        accent-color: var(--brand-orange);
        flex-shrink: 0;
    }

    .checkbox-label {
        font-size: 16px;
        color: var(--text);
        cursor: pointer;
        line-height: 1.4;
    }

    .form-actions {
        display: flex;
        justify-content: center;
    }

    .btn-submit {
        display: flex;
        justify-content: center;
        align-items: center;
        padding-left: 34px; 
        padding-right: 34px; 
        padding-top: 10px;
        padding-bottom: 12px;   
        background-color: var(--brand-orange-dark);
        color: var(--white);
        border: none;
        border-radius: 9999px;
        font-size: 1.2rem;
        font-weight: 500;
        font-family: var(--open-sans-font);
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-submit:active:not(:disabled) {
        transform: translateY(0);
    }

    .btn-submit:disabled {
        opacity: 1;
        cursor: not-allowed;
        background-color: var(--brand-orange);
    }

    .btn-secondary { 
        background-color: var(--brand-orange-dark); 
        color: var(--white); 
    }

    .form-message {
        display: none;
        padding: 1rem;
        border-radius: 8px;
        font-size: 0.95rem;
        text-align: center;
        animation: slideIn 0.3s ease;
    }

    .form-message.success {
        display: block;
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .form-message.error {
        display: block;
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .form-message p {
        margin: 0;
    }

    @keyframes slideIn {
        from {
        opacity: 0;
        transform: translateY(-10px);
        }
        to {
        opacity: 1;
        transform: translateY(0);
        }
    }

    @media (hover: hover) {
        .btn-submit:hover:not(:disabled) {
            background-color: var(--brand-orange-hover);
            box-shadow: 0 4px 12px rgba(255, 152, 84, 0.3);
        }
    }

    @media (max-width: 768px) {
        .form-grid {
        grid-template-columns: 1fr;
        }

        .section-title {
        font-size: 1.2rem;
        }

        .section-description {
            font-size: 1.1rem;
        }

        .form-label {
        font-size: 0.9rem;
        }

        .form-input {
        font-size: 16px; 
        }

        .radio-label {
            font-size: 1rem;
        }

        .radio-group {
            margin-bottom: 1.2rem;
        }

        .whatsapp-note {
            padding: 1.5rem;
            margin-top: 1rem;
        }

        .checkbox-group {
            gap: 1.2rem;
        }

        .form-radio, .form-checkbox {
            width: 18px;
            height: 18px;
            margin-top: 0.15rem;
        }

        .form-radio {
            width: 18px;
            height: 18px;
            margin-top: 0.2rem;
        }
    }
</style>

<script>
    const form = document.getElementById('membership-form') as HTMLFormElement;
    const messageDiv = document.getElementById('form-message') as HTMLDivElement;
    const submitBtn = form?.querySelector('.btn-submit') as HTMLButtonElement;
    const terminosCheckbox = document.getElementById('terminos') as HTMLInputElement;
    const privacidadCheckbox = document.getElementById('privacidad') as HTMLInputElement;

    const updateSubmitButtonState = () => {
        if (submitBtn) {
            const ambosAceptados = terminosCheckbox?.checked && privacidadCheckbox?.checked;
            submitBtn.disabled = !ambosAceptados;
        }
    };

    if (form && submitBtn) {
        submitBtn.disabled = true;

        terminosCheckbox?.addEventListener('change', updateSubmitButtonState);
        privacidadCheckbox?.addEventListener('change', updateSubmitButtonState);

        form.addEventListener('submit', async (e: Event) => {
            e.preventDefault();

            messageDiv.innerHTML = '';
            messageDiv.className = 'form-message';

            const formData = new FormData(form);
            
            const data = {
                apellido: formData.get('apellido'),
                nombre: formData.get('nombre'),
                fechaNacimiento: formData.get('fechaNacimiento'),
                numeroCelular: formData.get('numeroCelular'),
                correoElectronico: formData.get('correoElectronico'),
                ciudad: formData.get('ciudad'),
                provinciaEstado: formData.get('provinciaEstado'),
                pais: formData.get('pais'),
                comoConoce: formData.getAll('comoConoce').join(', '),
                whatsappAuto: formData.get('whatsappAuto') === 'true',
                aceptaTerminos: formData.get('aceptaTerminos') === 'on',
                aceptaPrivacidad: formData.get('aceptaPrivacidad') === 'on',
            };

            try {
                const response = await fetch('/api/membership', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(data),
                });

                const result = await response.json();

                if (response.ok) {
                    messageDiv.className = 'form-message success';
                    messageDiv.innerHTML = `<p>${result.message}</p>`;
                    form.reset();
                    updateSubmitButtonState();
                } else {
                    messageDiv.className = 'form-message error';
                    messageDiv.innerHTML = `<p>${result.error || 'Error al enviar el formulario'}</p>`;
                }
            } catch (error) {
                console.error('Error:', error);
                messageDiv.className = 'form-message error';
                messageDiv.innerHTML = '<p>Error al enviar el formulario. Intenta de nuevo.</p>';
            }
        });
    }
</script>

